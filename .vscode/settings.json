{
    "postman.settings.dotenv-detection-notification-visibility": false,
    "python-envs.defaultEnvManager": "ms-python.python:system",
    "python.analysis.exclude": [
        "**/node_modules",
        "**/__pycache__",
        "**/.*",
        "**/.tmp_classes/**",
        "**/.tmp_pdf/**",
        "**/.tmp_pdf_text/**"
    ],
    "python.analysis.ignore": [
        "**/.tmp_pdf/**",
        "**/.tmp_pdf_text/**"
    ],
    "markdownlint.ignore": [
        "reports/**",
        "**/reports/**",
        ".tmp_pdf/**",
        ".tmp_pdf_text/**",
        ".tmp_classes/**",
        "**/.tmp_pdf/**"
    ],
    "files.associations": {
        "**/.tmp_pdf/**/LICENSE": "plaintext",
        "**/.tmp_pdf/**/METADATA": "plaintext"
    },
    "files.watcherExclude": {
        "**/.tmp_pdf/**": true,
        "**/.tmp_pdf_text/**": true,
        "**/.tmp_classes/**": true
    },
    "search.exclude": {
        "**/.tmp_pdf/**": true,
        "**/.tmp_pdf_text/**": true,
        "**/.tmp_classes/**": true
    }
}
